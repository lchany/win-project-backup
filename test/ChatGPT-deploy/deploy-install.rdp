remoteapplicationmode:i:1
remoteapplicationname:s:ChatGPT Install
remoteapplicationprogram:s:powershell.exe
remoteapplicationcmdline:s:-ExecutionPolicy Bypass -NoProfile -Command "$log='\\tsclient\ChatGPT-deploy\remote-install.log'; try { $ErrorActionPreference='Stop'; 'START '+(Get-Date) | Out-File $log; $dest='C:\Temp\ChatGPT-deploy'; New-Item -ItemType Directory -Force -Path $dest | Out-Null; 'Copying package...' | Add-Content $log; Copy-Item -Path '\\tsclient\ChatGPT-deploy\ChatGPT-x64.msix','\\tsclient\ChatGPT-deploy\ChatGPT-License.xml','\\tsclient\ChatGPT-deploy\Install-ChatGPT.ps1' -Destination $dest -Force; 'Installing...' | Add-Content $log; & (Join-Path $dest 'Install-ChatGPT.ps1') *>&1 | Add-Content $log; 'VERIFY:' | Add-Content $log; Get-AppxPackage | Where-Object { $_.Name -like 'OpenAI.*' } | Format-List | Out-String | Add-Content $log; 'DONE '+(Get-Date) | Add-Content $log } catch { 'ERROR: '+$_.Exception.Message | Add-Content $log; exit 1 }"
prompt for credentials:i:0
authentication level:i:0
disableconnectionsharing:i:1
